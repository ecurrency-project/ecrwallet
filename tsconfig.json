{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react",
    "lib": ["es2020"],
    "noEmit": true,
    "strict": true,
    "target": "esnext",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "module": "esnext",
    "paths": {
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "extends": "@react-native/typescript-config",
  "exclude": ["**/node_modules", "**/Pods", "babel.config.js", "jest.config.js", "components/react-native-draggable-flatlist", "scripts/maccatalystpatches"],
}
